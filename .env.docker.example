# =========================================================
# PBL4_HTTM Docker Compose — Optional Overrides (.env)
# Mặc định không cần tạo file .env ở root cũng chạy được ngay:
#   docker compose up -d --build
# Nếu muốn tùy chỉnh cổng, DB Supabase hoặc SMTP, copy thành .env ở thư mục gốc.
# =========================================================

# Cổng Web Dashboard (mặc định 80 -> mở http://localhost hoặc http://<IP_LAN>)
WEB_PORT=80
BACKEND_PORT=3000
SERVER_AI_PORT=5000
POSTGRES_PORT=5432

# --- Database ---
# Mặc định dùng PostgreSQL Docker nội bộ (postgres:5432).
# Nếu muốn dùng Supabase PostgreSQL (Session/Transaction Pooler IPv4):
# DOCKER_DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASS@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# DOCKER_DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASS@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Auth & IoT ---
ACCESS_JWT_SECRET=pbl4_access_token_secret_key_2026_super_secure_node_jwt_auth_key
IOT_DEVICE_SECRET=your_iot_device_secret_token

# Mã thiết bị mặc định khi cầu nối server_ai đẩy sang backend
PBL4_DEVICE_ID=IOT-DN-01
# Tier-2 Verifier: b1 (MediaPipe HD + YOLO HD) | auto
TIER2_VERIFIER_MODE=b1

# Token cho Raspberry Pi 4 kết nối tới server_ai (:5000) (tối thiểu 16 ký tự)
SERVER_DEVICE_TOKEN=pbl4_server_ai_device_token_2026_dev
SERVER_ADMIN_TOKEN=pbl4_server_ai_admin_token_2026_dev

# --- Email Nodemailer (Tùy chọn) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_ALERT_EMAIL=
