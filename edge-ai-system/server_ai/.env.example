# ==========================================
# PI_AI Server of AI (:5000) — ENV EXAMPLE
# Copy file này thành .env để chạy cục bộ
# KHÔNG commit file .env lên Git
# ==========================================

# Profile: lab (localhost dev, có sẵn token lab-device-token) | prod (mở LAN 0.0.0.0)
SERVER_ENV_PROFILE=lab
SERVER_HTTP_HOST=127.0.0.1
SERVER_HTTP_PORT=5000
SERVER_UDP_PORT=5005

# Tier-2 AI Verifier: auto | heuristic | onnx | b1 (MediaPipe 468 HD + YOLO HD)
# Nếu máy chưa cài mediapipe/ultralytics, hệ thống tự fallback về TemporalBaselineVerifier
TIER2_VERIFIER_MODE=b1
SERVER_STITCH_MP4=1

# Cầu nối đẩy dữ liệu sang PBL4_HTTM Node.js Backend (:3000)
PBL4_BACKEND_URL=http://localhost:3000
PBL4_DEVICE_TOKEN=change_me_iot_device_secret
PBL4_DEVICE_ID=IOT-DN-01
# Để trống PBL4_TRIP_ID để Backend tự tra chuyến đang IN_PROGRESS của thiết bị
PBL4_TRIP_ID=
PBL4_TELEMETRY_INTERVAL_S=3.0
PBL4_HEARTBEAT_INTERVAL_S=30.0
PBL4_FORWARD_NON_PENALTY=0
