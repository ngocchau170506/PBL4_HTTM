{$DOMAIN_NAME::80} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:3000
    }

    handle /socket.io/* {
        reverse_proxy backend:3000
    }

    handle /uploads/* {
        reverse_proxy backend:3000
    }

    handle {
        root * /usr/src/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
