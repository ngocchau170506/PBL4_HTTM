# ========================
# PBL4 Fleet Backend — ENV EXAMPLE
# Copy file này thành .env và điền giá trị thực tế
# KHÔNG commit file .env vào git
# ========================

# --- DATABASE (SQLite - Dev) ---
# Prisma sử dụng file SQLite mặc định: prisma/dev.db
# Nếu muốn dùng PostgreSQL cho production:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL="postgresql://postgres:Ngocchau170506%40@db.zqklxkapzkbdscsrjbxb.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:Ngocchau170506%40@db.zqklxkapzkbdscsrjbxb.supabase.co:5432/postgres"

# --- SERVER ---
PORT=3000
NODE_ENV=development   # development | production

# --- JWT SECRETS (tối thiểu 64 ký tự random) ---
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_JWT_SECRET=

# --- SMTP (Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# --- URLS ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- IoT DEVICE AUTH ---
# Token xác thực cho ESP32 / Raspberry Pi (gửi qua header x-device-token)
IOT_DEVICE_SECRET=your_iot_device_secret_token

# --- REDIS CACHE (Tùy chọn) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
