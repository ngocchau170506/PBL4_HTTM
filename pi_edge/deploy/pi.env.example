# ==============================================================================
# PI_AI Raspberry Pi 4 Configuration (Single Source of Truth)
# Copy to pi.env (chmod 600 pi.env) — NEVER commit pi.env to Git!
# ==============================================================================

# --- Single Authoritative Mode (LCK-04 v2) ---
# local  = Full local Pi dashboard + /stream, ZERO connections to Server of AI
# server = Ultra-light Pi web (/api/v1/health, /api/esp_bridge) + HTTPS Keep-Alive to remote Server of AI
RUN_MODE=server
# Default 0 in server mode (no live MJPEG stream over 4G -> saves Pi CPU & bandwidth; clips still sent)
ENABLE_LIVE_STREAM=0
# prod = Strict RBAC boot (empty tokens -> fail startup)
# lab  = Localhost-only (127.0.0.1) dev bootstrap
ENV_PROFILE=prod
WEB_PORT=8080

# --- Required RBAC Tokens (generate via: openssl rand -hex 24) ---
WEB_ADMIN_TOKEN=
WEB_OPERATOR_TOKEN=
WEB_VIEWER_TOKEN=
DEVICE_BRIDGE_TOKEN=
REMOTE_AUTH_TOKEN=

# --- Vehicle Identity ---
VEHICLE_ID="XE-01"
VEHICLE_NAME="Xe Giam Sat PI_AI"
DRIVER_NAME="Tai xe 01"

# --- Camera RTSP (LAN eth0 netplan-eth0 preserved; ZERO nmcli/sudo!) ---
DISABLE_CAMERA=0
FD_CAMERA_IP=192.168.1.210
FD_CAMERA_PASSWORD=
FD_CAMERA_URI=
CAMERA_WIDTH=800
CAMERA_HEIGHT=448
CAMERA_FPS=30
CAMERA_ROTATION=180
CAMERA_PREFER_SUBSTREAM=1
CAMERA_STALL_RESET_S=6.0

# --- Tier-1 Edge AI (YOLO + BlazeFace 1-pass; Tier-2 CNN runs on Server of AI!) ---
DISABLE_AI=0
YOLO_MODEL_PATH=pi_edge/models/best.pt
LANDMARKER_PATH=pi_edge/models/face_landmarker.task
YOLO_IMGSZ=320
YOLO_MAX_DET=8
TORCH_THREADS=2
OPENCV_THREADS=1
AI_CPU_CORES=0,1,2

# --- Alert Thresholds & Hard-Clamped Blind Hold (<= 0.8s) ---
DROWSY_THRESHOLD_SECONDS=2.0
YAWNING_THRESHOLD_SECONDS=1.8
DISTRACTED_THRESHOLD_SECONDS=2.0
BLIND_HOLD_MAX_S=0.75
ALLOW_SMOKING_ALERTS=1
ALLOW_PHONE_ALERTS=1
YOLO_SMOKING_CONF=0.45
YOLO_PHONE_CONF=0.45

# --- ESP32 #1 Safety Node (Loa MAX98357A <5ms + MQ-135; Wi-Fi/BT/GPS OFF — unified 115200) ---
# Uses persistent udev symlinks from 99-pi-ai-esp32.rules (with automatic WHOAMI swap fallback)
ESP_PORT=/dev/esp_audio
ESP_BAUDRATE=115200
ESP_MODE=SERIAL
ESP_REQUIRE_ACK=1

# --- ESP32 #2 Comms & GPS Hub (BLE App + GPS UART2 GPIO16/17 + On-Demand Wi-Fi Survival — unified 115200) ---
ESP_BLE_MODE=SERIAL
ESP_BLE_PORT=/dev/esp_ble
ESP_BLE_BAUDRATE=115200
# Optional Wi-Fi hotspot credentials pushed dynamically to ESP32 #2 NVS for Pi-offline Survival Bridge (CFG_WIFI):
ESP_SURVIVAL_WIFI_SSID=
ESP_SURVIVAL_WIFI_PASS=

# --- Server of AI Uplink (used ONLY when RUN_MODE=server; Method B: Cloudflare Tunnel HTTPS) ---
# Replace with your remote Server's Cloudflare Tunnel URL (e.g. https://pi-ai.yourdomain.com)
REMOTE_SERVER_URL=https://replace-with-cloudflare-tunnel.trycloudflare.com
TELEMETRY_INTERVAL_S=1.5
BURST_MAX_FRAMES=16
EVIDENCE_JPEG_QUALITY=80
MAX_SPOOL_MB=512

# --- Thermal & Hardware Telemetry ---
HARDWARE_POLL_INTERVAL_S=5
PERF_LOG_INTERVAL=30
THERMAL_WARM_C=70
THERMAL_HOT_C=75
THERMAL_CRIT_C=80
