# ==============================================================================
# Environment Configuration for Raspberry Pi 4 Deployment
# Usage: set -a; source AI/deploy/pi.env; set +a
# ==============================================================================

# --- Chế độ Vận Hành Đầy Đủ IOTv3 (Bật Camera + AI + GPS + Truyền Tin Server) ---
GPS_ONLY=0
DISABLE_CAMERA=0
DISABLE_AI=0

# --- Camera Vantech / Dahua LAN RTSP Configuration (Dự án IOTv3) ---
# Password camera: tlJwpbo6 (User: admin, IP: 192.168.1.210 cắm cổng LAN RJ45 eth0)
FD_CAMERA_PASSWORD=tlJwpbo6
# URL RTSP camera ngoại (Vantech IP Camera 192.168.1.210):
# Format 1 (Vantech ONVIF chuẩn): rtsp://192.168.1.210:554/user=admin_password=tlJwpbo6_channel=1_stream=0&protocol=unicast&onvif=ture.sdp?real_stream
# Format 2 (Vantech /ch01/0):     rtsp://admin:tlJwpbo6@192.168.1.210:554/ch01/0
FD_CAMERA_URI='rtsp://192.168.1.210:554/user=admin_password=tlJwpbo6_channel=1_stream=0&protocol=unicast&onvif=ture.sdp?real_stream'
CAMERA_DEVICE=
ALLOW_BUILTIN_CAMERA=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# --- ESP32 UART Communication (Chuẩn G11: 921,600 bps + Auto-Baud 115,200) ---
FD_ESP32_URI=/dev/ttyUSB0
ESP_PORT=/dev/ttyUSB0
ESP_MODE=SERIAL
ESP_BAUDRATE=921600
UPLINK_MODE=esp32_gateway
ESP_REQUIRE_ACK=1
ESP_USE_VOICE=1
ESP_INTERRUPT_VOICE=0

# --- GPS gan tren ESP32 (UART2) -> khong can quet cong serial/USB GPS tren Pi ---
GPS_DIRECT_USB=0

# --- AI & Processing Parameters (Tối ưu chống quá nhiệt SoC Raspberry Pi 4) ---
YOLO_MODEL_PATH=AI/models/best.pt
LANDMARKER_PATH=AI/models/face_landmarker.task
# Chế độ 2 Pha tuần tự: MediaPipe chỉ chạy 10~15s đầu (mặc định 12s) để xác định baseline,
# sau đó đóng hoàn toàn MediaPipe và giao 100% cho YOLO thực hiện (không bao giờ chạy cả 2 cùng lúc).
MEDIAPIPE_PHASE_SECONDS=12.0
CALIBRATION_SECONDS=12.0
DISABLE_MEDIAPIPE=0        # Tự động dùng MediaPipe 12s đầu nếu CPU hỗ trợ, hoặc fallback an toàn trên Cortex-A72
ENABLE_BEHAVIOR_ALERTS=0   # Khóa hoàn toàn đọc/cảnh báo Smoking & phone, chỉ tập trung giám sát buồn ngủ sớm
YOLO_IMGSZ=320
SAMPLER_TARGET_FPS=30
CAMERA_CAPTURE_FPS=30
AI_INFER_FPS=8
TORCH_THREADS=2
# --- Điều tiết nhiệt thích ứng (IOTv4): hạ tải từ sớm để không chạm 70-80°C ---
THERMAL_WARM_C=58          # L1: giảm MediaPipe còn 1/2 nhịp, FPS<=4
THERMAL_HOT_C=65           # L2: YOLO/MediaPipe luân phiên (1 mô hình/nhịp), FPS<=3, duty<=60%
THERMAL_CRIT_C=72          # L3: FPS<=2, duty<=40%, YOLO imgsz giữ 320 để không mất box mắt nhỏ
AI_CPU_CORES=0,1,2         # ghim AI vào nhân 0-2, nhân 3 dành cho OS/mạng/UART
CAMERA_PREFER_SUBSTREAM=1  # ưu tiên luồng phụ (stream=1) của camera, tự rơi về luồng chính nếu không có
YOLO_MAX_DET=8
REMOTE_SCAN_SUBNET=0       # 1 = cho phép quét /24 tìm Server (tốn CPU, mặc định tắt)
EVIDENCE_JPEG_QUALITY=70
ENABLE_EVENT_RECORDER=1
# Cấu hình luồng lưu Video vi phạm liên tục 10s (-3s -> 0s -> 2s -> 3..6s -> đủ 10s tự đóng & mở đoạn mới):
CLIP_PRE_EVENT_S=3.0
CLIP_POST_CONFIRM_S=5.0
CLIP_MAX_DURATION_S=10.0
CLIP_SAMPLE_FPS=10.0
CLIP_WIDTH=320
CLIP_HEIGHT=240
HEADLESS=1
WEB_PORT=8080
SKIP_CALIBRATION=1
ALIGNMENT_TIMEOUT=30
DISTRACTION_THRESHOLD_SECONDS=1.5
HEAD_PITCH_THRESHOLD_DEG=22.0
HEAD_YAW_THRESHOLD_DEG=35.0
HEAD_ROLL_THRESHOLD_DEG=25.0
TRACKING_LOST_ALERT_S=3.0

# --- Telemetry & Diagnostic Logs ---
PERF_CSV=logs/performance.csv
PERF_LOG_INTERVAL=30.0
HARDWARE_POLL_INTERVAL_S=5
TEMP_ALERT_THRESHOLD_C=80.0

# --- Remote Server Connection ---
REMOTE_SERVER_ENABLED=1
# IP máy chủ trung tâm (Máy Server nhận dữ liệu: 172.20.10.3:5000)
REMOTE_SERVER_URL=http://172.20.10.3:5000
REMOTE_AUTH_TOKEN=
VEHICLE_ID="XE-01"
VEHICLE_NAME="Xe Giam Sat Thu Nghiem"
DRIVER_NAME="Tai xe 01"
TELEMETRY_INTERVAL_S=3.0
PUBLIC_TUNNEL_URL=
