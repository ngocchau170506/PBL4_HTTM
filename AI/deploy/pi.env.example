# Source this file in bash: set -a; source AI/deploy/pi.env; set +a
CAMERA_DEVICE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
YOLO_IMGSZ=416
HEADLESS=1
SKIP_CALIBRATION=0
ALIGNMENT_TIMEOUT=30
ESP_MODE=MOCK
ESP_BAUDRATE=115200
# Set the actual /dev/serial/by-id/... path before enabling SERIAL.
ESP_PORT=
# Only enable after firmware supports appended sequence and ACK,<sequence>.
ESP_REQUIRE_ACK=0
PERF_CSV=logs/performance.csv
