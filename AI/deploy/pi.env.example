# ==============================================================================
# Environment Configuration for Raspberry Pi 4 Deployment
# Usage: set -a; source AI/deploy/pi.env; set +a
# ==============================================================================

# --- Camera Vantech LAN RTSP Configuration ---
# Camera password for rtsp://192.168.1.210:554/...
FD_CAMERA_PASSWORD=tlJwpbo6
# Optional full URI override (leave empty to use template):
FD_CAMERA_URI=rtsp://admin:tlJwpbo6@192.168.1.210:554/ch01/0
CAMERA_DEVICE=
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=25
# Xoay camera: 0 (mac dinh), 180 (khi gan nguoc camera len kinh/tran xe), 90, 270
CAMERA_ROTATION=180
# Lat anh camera: de trong hoac h (ngang), v (doc), both
CAMERA_FLIP=

# --- ESP32 UART Communication ---
FD_ESP32_URI=/dev/ttyUSB0
ESP_PORT=/dev/ttyUSB0
ESP_MODE=SERIAL
ESP_BAUDRATE=115200
ESP_REQUIRE_ACK=1
ESP_USE_VOICE=1
ESP_INTERRUPT_VOICE=0

# --- AI & Processing Parameters ---
YOLO_MODEL_PATH=AI/models/best.pt
LANDMARKER_PATH=AI/models/face_landmarker.task
YOLO_IMGSZ=416
SAMPLER_TARGET_FPS=5
HEADLESS=1
WEB_PORT=8080
SKIP_CALIBRATION=0
ALIGNMENT_TIMEOUT=30
DISABLE_MEDIAPIPE=1

# --- Telemetry & Diagnostic Logs ---
PERF_CSV=logs/performance.csv
HARDWARE_POLL_INTERVAL_S=5
TEMP_ALERT_THRESHOLD_C=80.0
