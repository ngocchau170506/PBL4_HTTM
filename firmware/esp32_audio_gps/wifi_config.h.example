  { "REPLACE_WIFI_SSID_2", "REPLACE_WIFI_PASS_2", "http://192.168.1.100:5000" }
};
#define UPLINK_WIFI_COUNT (sizeof(UPLINK_WIFI_LIST) / sizeof(UPLINK_WIFI_LIST[0]))

#define UPLINK_SERVER_URL  "https://replace-with-server-url"
